{
  "name": "pointlurker",
  "private": true,
  "scripts": {
    "prepare": "husky && cd backend && dotnet tool restore"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx,css,scss,md,json}": [
      "npx --prefix frontend prettier --write"
    ],
    "backend/**/*.cs": [
      "sh -c 'cd backend && dotnet tool run csharpier format \"$@\"' --"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^17.0.0",
    "semantic-release": "^25.0.0",
    "@semantic-release/commit-analyzer": "^13",
    "@semantic-release/release-notes-generator": "^14",
    "@semantic-release/github": "^12.0.0"
  }
}
