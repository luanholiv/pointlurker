{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=PointLurker;Username=api;Password=api;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "AllowedHosts": "*",

  "StreamElements": {
    "BaseUrl": "https://api.streamelements.com"
  },

  "InputResolution": {
    "MatchThreshold": 85
  },

  "Sync": {
    "FetchCronExpression": "* * * * *",
    "UsernameRefreshCronExpression": "0 0 * * *",
    "MaxDegreeOfParallelism": 4,
    "ResolutionLogRetentionDays": 30
  },

  "Redemptions": {
    "PollingCronExpression": "* * * * *",
    "CompletionTimeoutHours": 24,
    "PollFailureAlertThreshold": 10,
    "RetrySweepIntervalMinutes": 5
  },

  "Credentials": {
    "ExpiryWarningHours": 48
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "you@gmail.com",
    "Password": "your_16_char_app_password",
    "From": "you@gmail.com",
    "Security": "StartTls",
    "MaxRetries": 3,
    "RetryBaseDelaySeconds": 2
  },

  "Authentication": {
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationHours": 24
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "DataProtection": {
    "KeyRingPath": ".dataprotection-keys"
  }
}
